// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ADMIN
  EMPLOYEE
  RECEPTIONIST
}

enum VisitStatus {
  PENDING     // ziyaretçi talep oluşturdu, çalışanın onayı bekleniyor
  ACCEPTED    // çalışan onayladı
  REJECTED    // çalışan reddetti
  CHECKED_IN  // ziyaretçi içeri girdi
  CHECKED_OUT // ziyaretçi çıktı
  CANCELLED   // ziyaretçi kendi talebini iptal etti
  EXPIRED     // link/talep süresi doldu
}

model Staff {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(EMPLOYEE)
  createdAt    DateTime  @default(now())

  hostedVisits Visit[] @relation("HostEmployee")
}

model Visitor {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  company   String?
  createdAt DateTime @default(now())

  visits Visit[]
}

model Visit {
  id             String      @id @default(cuid())
  visitor        Visitor     @relation(fields: [visitorId], references: [id])
  visitorId      String
  hostEmployee   Staff       @relation("HostEmployee", fields: [hostEmployeeId], references: [id])
  hostEmployeeId String

  visitReason String
  scheduledAt DateTime
  status      VisitStatus @default(PENDING)

  accessToken    String   @unique
  tokenExpiresAt DateTime

  requestedAt  DateTime  @default(now()) // ziyaretçi talebi ne zaman oluşturdu
  respondedAt  DateTime? // çalışan ne zaman onayladı/reddetti
  checkedInAt  DateTime?
  checkedOutAt DateTime?
}
