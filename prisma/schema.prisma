// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// SQL Server sabit değer listesini (enum) desteklemiyor, o yüzden role/status
// alanlarını metin (String) olarak tutuyoruz. Geçerli değerler şunlar:

// StaffRole: "ADMIN" | "EMPLOYEE" | "RECEPTIONIST"
// VisitStatus: "PENDING" (onay bekliyor) | "ACCEPTED" (onaylandı) | "REJECTED" (reddedildi)
//   | "CHECKED_IN" (içeri girdi) | "CHECKED_OUT" (çıktı) | "CANCELLED" (iptal edildi) | "EXPIRED" (süresi doldu)

model Staff {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("EMPLOYEE")
  department   String?
  createdAt    DateTime @default(now())

  hostedVisits Visit[]    @relation("HostEmployee")
  sentMessages Message[]  @relation("StaffMessages")

  @@map("vms_staff")
}

model Visitor {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  company   String?
  createdAt DateTime @default(now())

  visits Visit[]

  @@map("vms_visitor")
}

model Visit {
  id             String  @id @default(cuid())
  visitor        Visitor @relation(fields: [visitorId], references: [id])
  visitorId      String
  hostEmployee   Staff   @relation("HostEmployee", fields: [hostEmployeeId], references: [id])
  hostEmployeeId String

  visitReason String
  scheduledAt DateTime
  status      String   @default("PENDING")

  accessToken    String   @unique
  tokenExpiresAt DateTime

  requestedAt  DateTime  @default(now()) // ziyaretçi talebi ne zaman oluşturdu
  respondedAt  DateTime? // çalışan ne zaman onayladı/reddetti
  checkedInAt  DateTime?
  checkedOutAt DateTime?

  messages Message[]

  @@map("vms_visit")
}

// Ziyaretçi ile host arasındaki sohbet. Ziyaretçi accessToken linki
// üzerinden (giriş yapmadan), personel /staff/visits/[id]/chat üzerinden
// (host ya da ADMIN) mesajlaşıyor. Sadece ACCEPTED/CHECKED_IN/CHECKED_OUT
// durumlarında açık — bkz. src/actions/messages.ts isChatOpen.
model Message {
  id      String @id @default(cuid())
  visit   Visit  @relation(fields: [visitId], references: [id])
  visitId String

  // SenderType: "VISITOR" | "STAFF"
  senderType    String
  senderStaff   Staff?  @relation("StaffMessages", fields: [senderStaffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  senderStaffId String?

  body      String   @db.NVarChar(2000)
  createdAt DateTime @default(now())

  @@map("vms_message")
}
